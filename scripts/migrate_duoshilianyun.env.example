# 多式联运迁移：Thoughts 子目录 → 飞书「多式联运」
# cp scripts/migrate_duoshilianyun.env.example scripts/migrate_duoshilianyun.env

FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# 目标：多式联运
# https://<tenant>.feishu.cn/wiki/<parent_node_token>
FEISHU_PARENT_WIKI_TOKEN=your_parent_node_token
FEISHU_SPACE_ID=your_space_id
FEISHU_WIKI_BASE=https://<tenant>.feishu.cn

# 源：Thoughts 目录子树
THOUGHTS_EXPORT_URL=https://thoughts.aliyun.com/workspaces/<ws>/folders/<folder_id>

# 本地目录：thoughtsexport 默认落在 workspace 根，再同步到其子目录
EXPORT_STAGING_DIR=./thoughtsexport/bin/<company>/<workspace>
FEISHU_ROOT_DIR=./thoughtsexport/bin/<company>/<workspace>/多式联运
FEISHU_STATE_PATH=./feishu_import_state_duoshilianyun.json
FEISHU_LOCK_PATH=./feishu_import_duoshilianyun.lock
FEISHU_LOG_PATH=./feishu_import_duoshilianyun.log
