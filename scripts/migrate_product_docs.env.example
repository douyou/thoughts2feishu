# 产品文档迁移任务配置（复制为 migrate_product_docs.env 并填写）
# cp scripts/migrate_product_docs.env.example scripts/migrate_product_docs.env

# 飞书应用（与生态营销迁移同一应用即可）
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# 目标：产品文档
# https://wanlianyida.feishu.cn/wiki/CyHawCXfJizpvokzXMXcmafYn4l
FEISHU_PARENT_WIKI_TOKEN=CyHawCXfJizpvokzXMXcmafYn4l
FEISHU_SPACE_ID=7665238414152797450
FEISHU_WIKI_BASE=https://wanlianyida.feishu.cn

# 源：Thoughts 工作空间（overview 即整库导出）
# https://thoughts.aliyun.com/workspaces/6916f2c189ba36001b1009ee/overview
THOUGHTS_WORKSPACE_URL=https://thoughts.aliyun.com/workspaces/6916f2c189ba36001b1009ee/overview

# 本地路径（任务独立，避免与其他迁移互相覆盖）
FEISHU_ROOT_DIR=./tmp_export_product_docs
FEISHU_STATE_PATH=./feishu_import_state_product_docs.json
FEISHU_LOCK_PATH=./feishu_import_product_docs.lock
FEISHU_LOG_PATH=./feishu_import_product_docs.log

# 可选：打 L2（导入时自动打标；也可单独跑 scripts/set_l2_batch.py）
# 用户身份：FEISHU_USER_ACCESS_TOKEN / .feishu_user_token，或本机 lark-cli 用户登录
# FEISHU_USER_ACCESS_TOKEN=
# FEISHU_SECURE_LABEL_L2_ID=
# FEISHU_SECURE_LABEL_L2_NAME=L2-内部级
