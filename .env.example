# 飞书应用（开放平台 -> 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# 打文档密级必须用「用户身份」token（会过期，需定期刷新）
# 获取方式见 README「获取 user_access_token」
FEISHU_USER_ACCESS_TOKEN=

# 批量转移文档所有者时的新所有者 open_id（ou_xxx）
# 也可不填，改用上面的 FEISHU_USER_ACCESS_TOKEN 自动解析
# FEISHU_NEW_OWNER_OPEN_ID=

# 文档密级 ID（飞书管理后台密级配置中查看；按你们租户填写）
# 留空时若本机 lark-cli 已用户登录，将按 FEISHU_SECURE_LABEL_L2_NAME 自动查询
FEISHU_SECURE_LABEL_L2_ID=
# FEISHU_SECURE_LABEL_L2_NAME=L2-内部级

# 日志中拼文档链接用的租户域名（可选）
# FEISHU_WIKI_BASE=https://<your-tenant>.feishu.cn

# ---- 导入目标（每次迁移按目标知识库修改）----
# 父节点 wiki token：知识库页面 URL 中 /wiki/ 后面一段
FEISHU_PARENT_WIKI_TOKEN=your_parent_node_token
# 知识空间 ID：可用 get_node 接口返回的 space_id
FEISHU_SPACE_ID=your_space_id

# 本地导出根目录（Thoughts 导出后的目录树）
FEISHU_ROOT_DIR=./tmp_export

# 状态 / 锁 / 日志（可按任务改名，避免多任务互相覆盖）
FEISHU_STATE_PATH=./feishu_import_state.json
FEISHU_LOCK_PATH=./feishu_import.lock
FEISHU_LOG_PATH=./feishu_import.log

# 可选：在父节点下再建一层中间目录；留空则直接挂在父节点下
# FEISHU_CLEAN_ROOT_TITLE=ImportedDocs

# ---- 云效 Thoughts 导出 ----
# Cookie 字符串（含会话字段），不要提交到 Git
# THOUGHTS_COOKIE=
